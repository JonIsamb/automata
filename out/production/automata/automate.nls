to stop
  print "stop"
end

to move
  print "move"
  if (button-quit = true) [
    set next-activity [ -> quit ]
  ] [
    if (button-stop = true) [
      set next-activity [ -> stop ]
    ] [
      if (button-north = true) [
        set next-activity [ -> heads_north ]
      ] [
        if (button-west = true) [
          set next-activity [ -> heads_west ]
        ] [
          if (button-south = true) [
            set next-activity [ -> heads_south ]
          ] [
            if (button-east = true) [
              set next-activity [ -> heads_east ]
            ] ] ] ] ] ]
end

to heads_north
  print "heads_north"
  ; Automatic transitions based on stack top
  if (stack-top = "A") [
      set next-activity [ -> stop ]
  ] [
    if (stack-top = "M") [
        set next-activity [ -> move ]
  ]  ]
end

to heads_west
  print "heads_west"
  ; Automatic transitions based on stack top
  if (stack-top = "A") [
      set next-activity [ -> stop ]
  ] [
    if (stack-top = "M") [
        set next-activity [ -> move ]
  ]  ]
end

to heads_south
  print "heads_south"
  ; Automatic transitions based on stack top
  if (stack-top = "A") [
      set next-activity [ -> stop ]
  ] [
    if (stack-top = "M") [
        set next-activity [ -> move ]
  ]  ]
end

to heads_east
  print "heads_east"
  ; Automatic transitions based on stack top
  if (stack-top = "A") [
      set next-activity [ -> stop ]
  ] [
    if (stack-top = "M") [
        set next-activity [ -> move ]
  ]  ]
end

to jump
  print "jump"
  ; Automatic transition
  set next-activity [ -> stop ]
end

to pick_up
  print "pick_up"
  ; Automatic transition
  set next-activity [ -> stop ]
end

to drop
  print "drop"
  ; Automatic transition
  set next-activity [ -> stop ]
end

to quit
  print "quit"
end

