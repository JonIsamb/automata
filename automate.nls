;; Code NetLogo généré automatiquement
;; Automate: 10 états

to stop
  ;; to be completed
  print "stop"
end

to move
  ;; to be completed
  print "move"
  if (bouton-arreter = true) [
    set next-activity [ -> stop ]
  ] [
    if (bouton-quitter = true) [
    set next-activity [ -> quit ]
  ] [
    if (bouton-sud = true) [
    set next-activity [ -> heads_south ]
  ] [
    if (bouton-est = true) [
    set next-activity [ -> heads_east ]
  ] [
    if (bouton-ouest = true) [
    set next-activity [ -> heads_west ]
  ] [
    if (bouton-nord = true) [
    set next-activity [ -> heads_north ]
  ]   ]   ]   ]   ] ]
end

to heads_north
  ;; to be completed
  print "heads_north"
]
end

